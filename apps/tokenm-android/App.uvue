<script lang="uts">
import { bootstrapClientRuntime } from './services/client-runtime.uts'

export default {
  onLaunch() {
    // All push work remains inside the guarded runtime. App never requests permission itself.
    bootstrapClientRuntime().catch((_error) => {
      // The first page exposes retry UI; startup deliberately remains fail-closed.
    })
  },
  onShow() {
    bootstrapClientRuntime().catch((_error) => {
      // Foreground checks stop inside the guarded runtime when facts are no longer current.
    })
  }
}
</script>

