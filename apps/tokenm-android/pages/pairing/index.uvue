<template>
  <view class="page-shell">
    <scroll-view class="page-scroll" direction="vertical" :show-scrollbar="false">
      <view class="page-content">
        <tm-header title="配对码" :back="true" />
        <ui-state v-if="state == 'loading'" mode="loading" variant="dashboard" />
        <ui-state v-else-if="state == 'error'" mode="error" title="无法生成配对码" :detail="errorMessage" action-text="重试" @action="createCode" />
        <view v-else>
          <notice-banner v-if="paired" tone="success" text="电脑已绑定。你现在可以返回电脑列表查看连接状态。" />
          <notice-banner v-else-if="statusMessage.length > 0" tone="warning" :text="statusMessage" action-text="重试" @action="pollPairing" />
          <view v-if="!paired" :class="['pair-card', 'surface', expired ? 'pair-expired' : '']">
            <text class="pair-label">在 Potato Desktop 中输入</text>
            <text class="pair-code" :selectable="true">{{ displayCode }}</text>
            <text class="pair-time">{{ expired ? '配对码已失效' : countdown + ' 后失效' }}</text>
          </view>
          <button v-if="!paired" :class="['btn', 'btn-primary', 'section', expired || paired ? 'btn-disabled' : '']" hover-class="btn-primary-active" :disabled="expired || paired" @click="copyCode">复制配对码</button>
          <button v-if="!paired" class="btn btn-secondary btn-spaced" hover-class="btn-active" @click="confirmRefresh">刷新配对码</button>
          <view v-if="!paired" class="section steps">
            <text class="section-title">如何绑定</text>
            <view class="step"><text class="step-number">1</text><text class="step-copy">打开 Potato Desktop 设置</text></view>
            <view class="step"><text class="step-number">2</text><text class="step-copy">进入“移动通知”</text></view>
            <view class="step step-last"><text class="step-number">3</text><text class="step-copy">输入这组 6 位配对码</text></view>
          </view>
          <text v-if="!paired" class="privacy-caption">离开后，配对码仍在显示的有效期内可用。</text>
          <button :class="paired ? 'btn btn-primary section' : 'back-list'" @click="goDesktops">{{ paired ? '查看已绑定电脑' : '取消并返回电脑列表' }}</button>
        </view>
      </view>
    </scroll-view>
  </view>
</template>

<script setup lang="uts">
import { computed, ref } from 'vue'
import { onHide, onLoad, onShow, onUnload } from '@dcloudio/uni-app'
import { createPairingCode, getPairingStatus } from '../../services/client.uts'
import { ensureProtectedClientRoute } from '../../services/client-runtime.uts'
import { presentError } from '../../services/presentation.uts'
import type { UiLoadState } from '../../types/models.uts'

const state = ref<UiLoadState>('loading')
const code = ref('')
const sessionId = ref('')
const expiresAt = ref('')
const countdown = ref('10:00')
const expired = ref(false)
const paired = ref(false)
const errorMessage = ref('')
const statusMessage = ref('')
let countdownTimer = -1
let pollTimer = -1

const displayCode = computed((): string => code.value.length == 6 ? `${code.value.slice(0, 3)} ${code.value.slice(3)}` : code.value)

const stopTimers = () => {
  if (countdownTimer >= 0) clearInterval(countdownTimer)
  if (pollTimer >= 0) clearInterval(pollTimer)
  countdownTimer = -1
  pollTimer = -1
}

const updateCountdown = () => {
  const expiresAtMs = Date.parse(expiresAt.value)
  const remaining = Math.max(0, expiresAtMs - Date.now())
  const seconds = Math.ceil(remaining / 1000)
  const minutesPart = Math.floor(seconds / 60)
  const secondsPart = seconds % 60
  countdown.value = `${minutesPart < 10 ? '0' : ''}${minutesPart}:${secondsPart < 10 ? '0' : ''}${secondsPart}`
  expired.value = remaining <= 0
  if (expired.value) stopTimers()
}

const runPollPairing = async () => {
  if (expired.value || paired.value || sessionId.value.length == 0) return
  try {
    const current = await getPairingStatus(sessionId.value)
    statusMessage.value = ''
    if (current.status == 'paired') {
      paired.value = true
      stopTimers()
      uni.showToast({ title: '电脑绑定成功', icon: 'none' })
      return
    }
    if (current.status == 'expired' || current.status == 'superseded' || current.status == 'locked') {
      expired.value = true
      stopTimers()
    }
  } catch (error) {
    statusMessage.value = presentError(error, '暂时无法确认配对状态；配对码仍按显示时间有效。')
  }
}

const pollPairing = () => {
  runPollPairing()
}

const startTimers = () => {
  stopTimers()
  if (code.value.length == 0 || expired.value) return
  countdownTimer = setInterval(() => {
    updateCountdown()
  }, 1000)
  pollTimer = setInterval(() => {
    pollPairing()
  }, 5000)
}

const runCreateCode = async () => {
  stopTimers()
  state.value = 'loading'
  errorMessage.value = ''
  statusMessage.value = ''
  paired.value = false
  try {
    const result = await createPairingCode()
    sessionId.value = result.sessionId
    code.value = result.code
    expiresAt.value = result.expiresAt
    paired.value = result.status == 'paired'
    expired.value = false
    updateCountdown()
    startTimers()
    state.value = 'ready'
  } catch (error) {
    errorMessage.value = presentError(error, '服务暂时不可用，请稍后重试。')
    state.value = 'error'
  }
}

const createCode = () => {
  runCreateCode()
}

const copyCode = () => {
  if (expired.value || paired.value) return
  uni.setClipboardData({ data: code.value })
}

const confirmRefresh = () => {
  uni.showModal({
    title: '刷新配对码',
    content: '生成新配对码后，当前配对码会立即失效。',
    confirmText: '刷新',
    success: (result) => {
      if (result.confirm) createCode()
    }
  })
}

const goDesktops = () => {
  uni.reLaunch({ url: '/pages/desktops/index' })
}

const runLoadPage = async (_options: OnLoadOptions) => {
  if (!await ensureProtectedClientRoute()) return
  await runCreateCode()
}

onLoad((options: OnLoadOptions) => {
  runLoadPage(options)
})
onShow(() => {
  startTimers()
})
onHide(() => {
  stopTimers()
})
onUnload(() => {
  stopTimers()
})
</script>

<style lang="scss">
.pair-card { margin-top: 20px; align-items: center; padding-top: 32px; padding-right: 16px; padding-bottom: 32px; padding-left: 16px; border-color: #d8e4f4; background-color: #edf3fb; }
.pair-label { color: $tm-text-2; font-size: 13px; line-height: 20px; }
.pair-code { margin-top: 14px; color: $tm-text-1; font-family: "SFMono-Regular", Consolas, monospace; font-size: 34px; font-weight: 700; letter-spacing: 4px; line-height: 46px; }
.pair-time { margin-top: 10px; color: $tm-info; font-size: 12px; line-height: 18px; }
.pair-expired { background-color: $tm-surface-2; }
.step { min-height: 48px; flex-direction: row; align-items: center; border-bottom-width: 1px; border-bottom-style: solid; border-bottom-color: $tm-line; }
.step-last { border-bottom-width: 0; }
.step-number { width: 28px; height: 28px; margin-right: 10px; border-width: 1px; border-style: solid; border-color: $tm-line-strong; border-radius: 14px; color: $tm-info; font-size: 12px; line-height: 28px; text-align: center; }
.step-copy { flex: 1; color: $tm-text-2; font-size: 14px; line-height: 22px; }
.back-list { width: 100%; min-height: 48px; margin-top: 12px; color: $tm-text-3; background-color: transparent; font-size: 13px; line-height: 48px; }
</style>
