<template>
  <view class="page-shell">
    <scroll-view
      class="page-scroll"
      direction="vertical"
      :show-scrollbar="false"
      :refresher-enabled="true"
      :refresher-triggered="refreshing"
      @refresherrefresh="pullRefresh"
    >
      <view class="page-content page-content-with-tabs">
        <tm-header title="Potato" action-text="设置" @action="goSettings" />
        <notice-banner v-if="banner.length > 0" tone="warning" :text="banner" action-text="重试" @action="refresh" />
        <ui-state v-if="state == 'loading'" mode="loading" variant="dashboard" />
        <ui-state v-else-if="state == 'error'" mode="error" title="无法载入首页" :detail="errorMessage" action-text="重试" @action="refresh" />
        <view v-else>
          <view class="notification-focus surface">
            <view class="focus-copy">
              <text class="focus-title">{{ !dashboard.notifications.notificationsEnabled ? '任务通知已关闭' : (runtimeFacts.pushReadiness == 'ready' ? '任务通知已开启' : '通知需要设置') }}</text>
              <status-marker :tone="!dashboard.notifications.notificationsEnabled ? 'neutral' : pushReadinessView(runtimeFacts.pushReadiness).tone" :label="!dashboard.notifications.notificationsEnabled ? '任务记录仍会保存' : pushReadinessView(runtimeFacts.pushReadiness).label" />
              <text class="focus-detail">{{ dashboard.activeDesktopCount > 0 ? 'Codex 完成后，在这里查看最近任务。' : '绑定一台电脑，开始接收任务完成记录。' }}</text>
            </view>
            <button class="focus-action" hover-class="focus-action-active" @click="goNotifications">通知设置</button>
          </view>

          <view class="summary-line">
            <text class="summary-text">今日完成记录 {{ dashboard.todayCompletedCount }} 条</text>
            <text class="summary-divider">·</text>
            <text class="summary-text">{{ dashboard.activeDesktopCount }} 台电脑已绑定</text>
          </view>

          <view class="section">
            <view class="section-head">
              <text class="section-title">最近任务</text>
              <button class="section-link" @click="goTasks">查看全部</button>
            </view>
            <view v-if="dashboard.recentTasks.length > 0" class="plain-list surface">
              <view
                v-for="(item, index) in dashboard.recentTasks.slice(0, 3)"
                :key="item.taskId"
                :class="['row', 'row-press', index == Math.min(dashboard.recentTasks.length, 3) - 1 ? 'row-last' : '']"
                hover-class="row-press-active"
                @click="openTask(item.taskId)"
              >
                <view class="row-main">
                  <text class="row-title task-title">{{ taskTitle(item) }} · 已完成</text>
                  <text class="row-meta">{{ item.desktopName }} · {{ deliveryView(item.notificationStatus).label }}</text>
                </view>
                <text class="row-meta">{{ formatRelativeTime(item.occurredAt, Date.now()) }}</text>
              </view>
            </view>
            <ui-state v-else mode="empty" :compact="true" title="尚无任务" detail="完成一次 Codex 任务后，它会出现在这里。" />
          </view>
          <view class="section">
            <view class="section-head">
              <text class="section-title">电脑</text>
              <button class="section-link" @click="goDesktops">查看全部</button>
            </view>
            <view v-if="dashboard.desktops.length > 0" class="plain-list surface">
              <view v-for="(item, index) in dashboard.desktops.slice(0, 3)" :key="item.desktopId" :class="['row', index == Math.min(dashboard.desktops.length, 3) - 1 ? 'row-last' : '']">
                <status-marker class="desktop-status" :tone="desktopStatusView(item).tone" :label="desktopStatusView(item).label" />
                <view class="row-main desktop-copy">
                  <text class="row-title">{{ item.name }}</text>
                  <text class="row-meta">{{ desktopStatusView(item).detail }}</text>
                </view>
              </view>
            </view>
            <ui-state v-else mode="empty" :compact="true" title="尚未绑定电脑" detail="在 Potato Desktop 输入配对码即可连接。" action-text="绑定电脑" @action="goPairing" />
          </view>


        </view>
      </view>
    </scroll-view>
    <tm-tab-bar selected="home" />
  </view>
</template>

<script setup lang="uts">
import { nextTick, ref } from 'vue'
import { onReady, onShow } from '@dcloudio/uni-app'
import { getDashboard } from '../../services/client.uts'
import {
  canReuseProtectedPageData,
  prepareClientPage,
  settledRuntimeFacts,
  flushPendingNotificationRoute,
  getRuntimeFacts,
  markClientNavigationReady
} from '../../services/client-runtime.uts'
import {
  consentFactView,
  deliveryView,
  desktopStatusView,
  formatRelativeTime,
  loginFactView,
  mobileRegistrationFactView,
  permissionView,
  presentError,
  pushReadinessView,
  taskTitle
} from '../../services/presentation.uts'
import type { DashboardView, RuntimeFacts, UiLoadState } from '../../types/models.uts'
import { dashboardSnapshot, desktopsSnapshot, getPageCacheSession, isPageCacheSessionCurrent } from '../../services/page-cache.uts'
import { navigateColumn, PageTiming } from '../../services/navigation-perf.uts'

const state = ref<UiLoadState>('loading')
const dashboard = ref<DashboardView>({
  todayCompletedCount: 0,
  activeDesktopCount: 0,
  desktops: [],
  recentTasks: [],
  notifications: {
    notificationsEnabled: false,
    permissionState: 'notDetermined',
    clientRegistration: 'notStarted'
  }
})
const runtimeFacts = ref<RuntimeFacts>(getRuntimeFacts())
const errorMessage = ref('')
const banner = ref('')
const refreshing = ref(false)
const timing = new PageTiming('/pages/dashboard/index')
let loading = false

const restoreCached = () => {
  const cached = canReuseProtectedPageData() ? dashboardSnapshot.peek() : null
  if (cached == null) { state.value = 'loading'; return }
  dashboard.value = cached
  runtimeFacts.value = getRuntimeFacts()
  state.value = 'ready'
  nextTick(() => { timing.cachedReady() })
}
restoreCached()

const runLoad = async (keepExisting: boolean) => {
  if (loading) return
  loading = true
  const session = getPageCacheSession()
  const revision = dashboardSnapshot.revision
  const previousUpdate = dashboardSnapshot.updatedAt
  if (!keepExisting) state.value = 'loading'
  errorMessage.value = ''
  try {
    runtimeFacts.value = await prepareClientPage()
    settledRuntimeFacts().then((value: RuntimeFacts) => {
      if (isPageCacheSessionCurrent(session)) runtimeFacts.value = value
    }).catch((_error) => {})
    if (!isPageCacheSessionCurrent(session) && runtimeFacts.value.login == 'signedIn' && runtimeFacts.value.privacyConsent == 'current') return
    if (runtimeFacts.value.login != 'signedIn') {
      uni.reLaunch({ url: '/pages/login/index' })
      return
    }
    if (runtimeFacts.value.privacyConsent != 'current') {
      uni.reLaunch({ url: '/pages/permission/index' })
      return
    }
    const result = await getDashboard()
    if (!isPageCacheSessionCurrent(session)) return
    if (revision != dashboardSnapshot.revision) return
    dashboard.value = result
    banner.value = ''
    state.value = 'ready'
    nextTick(() => {
      if (dashboardSnapshot.updatedAt > previousUpdate) timing.freshReady()
      else timing.cachedReady()
    })
  } catch (error) {
    if (!isPageCacheSessionCurrent(session)) return
    const shown = presentError(error, '服务暂时不可用，请稍后重试。')
    if (keepExisting) {
      banner.value = `更新失败：${shown}`
    } else {
      errorMessage.value = shown
      state.value = 'error'
    }
  } finally {
    loading = false
  }
}

const refresh = () => {
  dashboardSnapshot.expire()
  desktopsSnapshot.expire()
  runLoad(state.value == 'ready')
}

const runPullRefresh = async () => {
  if (refreshing.value) return
  refreshing.value = true
  dashboardSnapshot.expire()
  desktopsSnapshot.expire()
  try {
    await runLoad(state.value == 'ready')
  } finally {
    refreshing.value = false
  }
}

const pullRefresh = () => {
  runPullRefresh()
}
const goSettings = () => {
  navigateColumn('/pages/settings/index')
}
const goNotifications = () => {
  uni.navigateTo({ url: '/pages/notifications/index' })
}
const goDesktops = () => {
  navigateColumn('/pages/desktops/index')
}
const goPairing = () => {
  uni.navigateTo({ url: '/pages/pairing/index' })
}
const goTasks = () => {
  navigateColumn('/pages/tasks/index')
}
const openTask = (taskId: string) => {
  uni.navigateTo({ url: `/pages/task-detail/index?taskId=${encodeURIComponent(taskId)}` })
}

onShow(() => {
  restoreCached()
  runLoad(state.value == 'ready')
})
onReady(() => {
  timing.shellReady()
  markClientNavigationReady()
  flushPendingNotificationRoute()
})
</script>

<style lang="scss">
.notification-focus { margin-top: 16px; padding: 16px; }
.focus-copy { min-width: 0; flex: 1; }
.focus-title { margin-bottom: 5px; color: $tm-text-1; font-size: 20px; font-weight: 600; line-height: 26px; }
.focus-detail { margin-top: 3px; color: $tm-text-3; font-size: 12px; line-height: 18px; }
.push-marker { margin-top: 8px; }
.focus-action { min-height: 48px; margin-top: 8px; color: $tm-info; background-color: transparent; font-size: 13px; line-height: 48px; }
.focus-action-active { opacity: 0.8; }
.summary-line { flex-direction: row; flex-wrap: wrap; align-items: center; margin-top: 16px; }
.summary-text { color: $tm-text-2; font-size: 13px; line-height: 20px; }
.summary-divider { margin-right: 6px; margin-left: 6px; color: $tm-line-strong; font-size: 13px; }
.desktop-status { width: 66px; }
.desktop-copy { margin-left: 10px; }
.plain-list { padding-right: 16px; padding-left: 16px; }
.row-press { align-items: stretch; flex-direction: column; }
</style>
