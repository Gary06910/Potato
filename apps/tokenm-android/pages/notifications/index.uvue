<template>
  <view class="page-shell">
    <scroll-view class="page-scroll" direction="vertical" :show-scrollbar="false">
      <view class="page-content">
        <tm-header title="任务通知" :back="true" />
        <notice-banner v-if="banner.length > 0" tone="warning" :text="banner" action-text="重试" @action="refresh" />
        <ui-state v-if="state == 'loading'" mode="loading" variant="dashboard" />
        <ui-state v-else-if="state == 'error'" mode="error" title="无法读取通知设置" :detail="errorMessage" action-text="重试" @action="refresh" />
        <view v-else>
          <view class="permission-focus surface">
            <text class="focus-title">系统通知</text>
            <status-marker :tone="permissionView(facts.notificationPermission).tone" :label="permissionView(facts.notificationPermission).label" />
            <text class="focus-detail">{{ permissionView(facts.notificationPermission).detail }}</text>
          </view>


          <view class="setting-row section">
            <view class="setting-copy">
              <text class="setting-title">任务通知</text>
              <text class="setting-detail">{{ settings.notificationsEnabled ? '已开启 · 任务完成时提醒你' : '已关闭 · 任务记录仍会保存' }}</text>
            </view>
            <switch :checked="settings.notificationsEnabled" :disabled="working || facts.login != 'signedIn' || facts.privacyConsent != 'current'" color="#2869c9" aria-label="任务通知开关" @change="toggleEnabled" />
          </view>

          <button
            v-if="facts.login != 'signedIn'"
            class="btn btn-primary section"
            hover-class="btn-primary-active"
            @click="goLogin"
          >前往登录</button>
          <button
            v-else-if="facts.privacyConsent != 'current'"
            class="btn btn-primary section"
            hover-class="btn-primary-active"
            @click="goPermission"
          >前往隐私确认</button>
          <button
            v-else-if="facts.notificationPermission != 'authorized'"
            :class="['btn', 'btn-primary', 'section', working ? 'btn-disabled' : '']"
            hover-class="btn-primary-active"
            :disabled="working"
            @click="requestNotificationPermissionFromCtaAction"
          >{{ working ? '正在更新…' : (facts.notificationPermission == 'denied' ? '打开系统通知设置' : '开启系统通知') }}</button>
          <button v-else-if="facts.mobileRegistration != 'ready'" class="btn btn-primary section" hover-class="btn-primary-active" :disabled="working" @click="retryRegistration">恢复通知服务</button>
          <text v-else class="notification-help">通知服务已就绪</text>

          <notice-banner
            v-if="facts.recoveryCode == 'privacy_consent_required'"
            class="section"
            tone="warning"
            text="隐私说明已更新，请重新确认以恢复任务通知。"
            action-text="前往确认"
            @action="goPermission"
          />

          <view class="surface detail-list section">
            <view class="detail-row">
              <text class="detail-key">登录</text>
              <text class="detail-value">{{ loginFactView(facts.login).label }}</text>
            </view>
            <view class="detail-row">
              <text class="detail-key">隐私确认</text>
              <text class="detail-value">{{ consentFactView(facts.privacyConsent).label }}</text>
            </view>
            <view class="detail-row">
              <text class="detail-key">系统权限</text>
              <text class="detail-value">{{ permissionView(facts.notificationPermission).label }}</text>
            </view>
            <view class="detail-row detail-row-last">
              <text class="detail-key">通知服务</text>
              <text class="detail-value">{{ mobileRegistrationFactView(facts.mobileRegistration).label }}</text>
            </view>
          </view>
          <text class="notification-help">若收不到提醒，请检查系统通知权限和手机省电设置。</text>
          <view class="surface detail-list section icon-diagnostics">
            <text class="setting-title">通知图标诊断</text>
            <view class="detail-row"><text class="detail-key">Getui SDK</text><text class="detail-value">{{ iconDiagnostics.sdkVersion }}</text></view>
            <view class="detail-row"><text class="detail-key">Android package</text><text class="detail-value">{{ iconDiagnostics.packageName }}</text></view>
            <view class="detail-row"><text class="detail-key">push_small 资源</text><text class="detail-value">{{ resourceView(iconDiagnostics.pushSmallResourceId) }}</text></view>
            <view class="detail-row"><text class="detail-key">push 资源</text><text class="detail-value">{{ resourceView(iconDiagnostics.pushResourceId) }}</text></view>
            <view class="detail-row"><text class="detail-key">自动绑定</text><text class="detail-value">{{ bindingView(iconDiagnostics.autoBindingState) }}</text></view>
            <view class="detail-row"><text class="detail-key">最近绑定</text><text class="detail-value">{{ sourceView(iconDiagnostics.lastBindingSource) }} · {{ bindingView(iconDiagnostics.lastBindingResult) }}</text></view>
            <view class="detail-row detail-row-last"><text class="detail-key">异常类别</text><text class="detail-value">{{ iconDiagnostics.lastBindingErrorCategory }}</text></view>
            <button class="btn btn-secondary section" :disabled="bindingIcons" @click="rebindIcons">{{ bindingIcons ? '正在绑定…' : '重新绑定通知图标' }}</button>
            <button class="btn btn-secondary section" @click="readCurrentNotificationIcons">读取当前通知图标</button>
            <!-- #ifdef APP-ANDROID -->
            <text class="setting-detail">临时 forensic 实验：根因定位后删除此控制 UI。</text>
            <button class="btn btn-secondary section" @click="sendLocalNotification">发送本地图标测试通知</button>
            <button class="btn btn-secondary section" @click="readLocalNotificationIcons">读取本地图标测试通知</button>
            <view v-if="nativeDiagnostic != null" class="section">
              <view class="detail-row"><text class="detail-key">push_small resource ID</text><text class="detail-value">{{ iconResourceIdView(nativeDiagnostic.pushSmallResourceId) }}</text></view>
              <view class="detail-row"><text class="detail-key">notify result</text><text class="detail-value">{{ nativeDiagnostic.state }}</text></view>
            </view>
            <view v-if="localIconInspection != null" class="section">
              <text class="setting-title">Local native notification</text>
              <view class="detail-row"><text class="detail-key">读取状态</text><text class="detail-value">{{ localIconInspection.state }}</text></view>
              <view class="detail-row"><text class="detail-key">Channel</text><text class="detail-value">{{ localIconInspection.channelId }}</text></view>
              <view class="detail-row"><text class="detail-key">SmallIcon type</text><text class="detail-value">{{ localIconInspection.smallIcon.type }}</text></view>
              <view class="detail-row"><text class="detail-key">SmallIcon package</text><text class="detail-value">{{ localIconInspection.smallIcon.resourcePackage }}</text></view>
              <view class="detail-row"><text class="detail-key">SmallIcon ID</text><text class="detail-value">{{ iconResourceIdView(localIconInspection.smallIcon.resourceId) }}</text></view>
              <view class="detail-row"><text class="detail-key">SmallIcon name</text><text class="detail-value">{{ localIconInspection.smallIcon.resourceName }}</text></view>
              <view class="detail-row"><text class="detail-key">匹配 push_small</text><text class="detail-value">{{ localIconInspection.matchPushSmall }}</text></view>
              <text class="setting-title">Actual preview</text>
              <image v-if="localIconInspection.smallIcon.previewDataUrl.length > 0" class="icon-preview" mode="aspectFit" :src="localIconInspection.smallIcon.previewDataUrl" />
              <text class="setting-detail">LARGE_ICON: NONE · SystemUI visual：由用户观察</text>
            </view>
            <button class="btn btn-secondary section" @click="readApplicationIcons">读取应用与启动图标</button>
            <view v-if="applicationIconInspection != null" class="section">
              <view class="detail-row"><text class="detail-key">应用图标状态</text><text class="detail-value">{{ applicationIconInspection.state }}</text></view>
              <view class="detail-row"><text class="detail-key">Package</text><text class="detail-value">{{ applicationIconInspection.packageName }}</text></view>
              <text class="setting-title">APPLICATION_ICON · ApplicationInfo.icon</text>
              <view class="detail-row"><text class="detail-key">resource ID</text><text class="detail-value">{{ iconResourceIdView(applicationIconInspection.applicationIcon.resourceId) }}</text></view>
              <view class="detail-row"><text class="detail-key">resource package</text><text class="detail-value">{{ applicationIconInspection.applicationIcon.resourcePackage }}</text></view>
              <view class="detail-row"><text class="detail-key">resource name</text><text class="detail-value">{{ applicationIconInspection.applicationIcon.resourceName }}</text></view>
              <image v-if="applicationIconInspection.applicationIcon.previewDataUrl.length > 0" class="icon-preview" mode="aspectFit" :src="applicationIconInspection.applicationIcon.previewDataUrl" />
              <text class="setting-title">APPLICATION_LOGO</text>
              <view class="detail-row"><text class="detail-key">resource ID</text><text class="detail-value">{{ applicationIconInspection.applicationLogo.resourceId > 0 ? iconResourceIdView(applicationIconInspection.applicationLogo.resourceId) : 'none' }}</text></view>
              <view v-if="applicationIconInspection.applicationLogo.resourceId > 0" class="detail-row"><text class="detail-key">resource name</text><text class="detail-value">{{ applicationIconInspection.applicationLogo.resourceName }}</text></view>
              <image v-if="applicationIconInspection.applicationLogo.previewDataUrl.length > 0" class="icon-preview" mode="aspectFit" :src="applicationIconInspection.applicationLogo.previewDataUrl" />
              <text class="setting-title">ACTIVITY_LOGO</text>
              <view class="detail-row"><text class="detail-key">resource ID</text><text class="detail-value">{{ applicationIconInspection.launcherActivityLogo.resourceId > 0 ? iconResourceIdView(applicationIconInspection.launcherActivityLogo.resourceId) : 'none' }}</text></view>
              <view v-if="applicationIconInspection.launcherActivityLogo.resourceId > 0" class="detail-row"><text class="detail-key">resource name</text><text class="detail-value">{{ applicationIconInspection.launcherActivityLogo.resourceName }}</text></view>
              <image v-if="applicationIconInspection.launcherActivityLogo.previewDataUrl.length > 0" class="icon-preview" mode="aspectFit" :src="applicationIconInspection.launcherActivityLogo.previewDataUrl" />
              <text class="setting-title">PackageManager.getApplicationIcon</text>
              <image v-if="applicationIconInspection.packageManagerIconPreviewDataUrl.length > 0" class="icon-preview" mode="aspectFit" :src="applicationIconInspection.packageManagerIconPreviewDataUrl" />
              <text class="setting-title">ROUND_ICON · ApplicationInfo.roundIconRes</text>
              <view class="detail-row"><text class="detail-key">读取状态</text><text class="detail-value">{{ applicationIconInspection.roundIconState }}</text></view>
              <view class="detail-row"><text class="detail-key">resource ID</text><text class="detail-value">{{ iconResourceIdView(applicationIconInspection.roundIcon.resourceId) }}</text></view>
              <view class="detail-row"><text class="detail-key">resource package</text><text class="detail-value">{{ applicationIconInspection.roundIcon.resourcePackage }}</text></view>
              <view class="detail-row"><text class="detail-key">resource name</text><text class="detail-value">{{ applicationIconInspection.roundIcon.resourceName }}</text></view>
              <image v-if="applicationIconInspection.roundIcon.previewDataUrl.length > 0" class="icon-preview" mode="aspectFit" :src="applicationIconInspection.roundIcon.previewDataUrl" />
              <text class="setting-title">LAUNCHER_ACTIVITY_ICON · ActivityInfo.icon</text>
              <view class="detail-row"><text class="detail-key">component</text><text class="detail-value">{{ applicationIconInspection.launcherComponent }}</text></view>
              <view class="detail-row"><text class="detail-key">resource ID</text><text class="detail-value">{{ iconResourceIdView(applicationIconInspection.launcherActivityIcon.resourceId) }}</text></view>
              <view class="detail-row"><text class="detail-key">resource package</text><text class="detail-value">{{ applicationIconInspection.launcherActivityIcon.resourcePackage }}</text></view>
              <view class="detail-row"><text class="detail-key">resource name</text><text class="detail-value">{{ applicationIconInspection.launcherActivityIcon.resourceName }}</text></view>
              <image v-if="applicationIconInspection.launcherActivityIcon.previewDataUrl.length > 0" class="icon-preview" mode="aspectFit" :src="applicationIconInspection.launcherActivityIcon.previewDataUrl" />
              <text class="setting-title">Launcher effective icon · ActivityInfo.loadIcon</text>
              <image v-if="applicationIconInspection.launcherEffectivePreviewDataUrl.length > 0" class="icon-preview" mode="aspectFit" :src="applicationIconInspection.launcherEffectivePreviewDataUrl" />
              <text class="setting-title">NOTIFICATION_PUSH_SMALL</text>
              <view class="detail-row"><text class="detail-key">resource ID</text><text class="detail-value">{{ iconResourceIdView(applicationIconInspection.pushSmallIcon.resourceId) }}</text></view>
              <view class="detail-row"><text class="detail-key">resource package</text><text class="detail-value">{{ applicationIconInspection.pushSmallIcon.resourcePackage }}</text></view>
              <view class="detail-row"><text class="detail-key">resource name</text><text class="detail-value">{{ applicationIconInspection.pushSmallIcon.resourceName }}</text></view>
              <image v-if="applicationIconInspection.pushSmallIcon.previewDataUrl.length > 0" class="icon-preview" mode="aspectFit" :src="applicationIconInspection.pushSmallIcon.previewDataUrl" />
              <view v-if="applicationIconInspection.drawableIcon.resourceId > 0">
                <text class="setting-title">Manifest drawable/icon</text>
                <image v-if="applicationIconInspection.drawableIcon.previewDataUrl.length > 0" class="icon-preview" mode="aspectFit" :src="applicationIconInspection.drawableIcon.previewDataUrl" />
              </view>
            </view>
            <!-- #endif -->
            <view v-if="activeIconInspection != null" class="section">
              <text class="setting-title">UniPush notification</text>
              <text class="setting-detail">SystemUI visual：由用户观察</text>
              <view class="detail-row"><text class="detail-key">读取状态</text><text class="detail-value">{{ activeIconInspection.state }}</text></view>
              <view class="detail-row"><text class="detail-key">活动通知</text><text class="detail-value">{{ activeIconInspection.activeCount }}</text></view>
              <text v-if="activeIconInspection.state == 'NO_ACTIVE_NOTIFICATION'" class="setting-detail">请先保留一条通知，再重新读取。</text>
              <view class="detail-row"><text class="detail-key">Channel</text><text class="detail-value">{{ activeIconInspection.channelId }}</text></view>
              <text class="setting-title">Expected push_small</text>
              <view class="detail-row"><text class="detail-key">resource ID</text><text class="detail-value">{{ iconResourceIdView(activeIconInspection.expectedPushSmallId) }}</text></view>
              <image v-if="activeIconInspection.expectedPreviewDataUrl.length > 0" class="icon-preview" mode="aspectFit" :src="activeIconInspection.expectedPreviewDataUrl" />
              <text class="setting-title">Actual smallIcon</text>
              <view class="detail-row"><text class="detail-key">类型</text><text class="detail-value">{{ activeIconInspection.smallIcon.type }}</text></view>
              <view class="detail-row"><text class="detail-key">package</text><text class="detail-value">{{ activeIconInspection.smallIcon.resourcePackage }}</text></view>
              <view class="detail-row"><text class="detail-key">resource ID</text><text class="detail-value">{{ iconResourceIdView(activeIconInspection.smallIcon.resourceId) }}</text></view>
              <view class="detail-row"><text class="detail-key">resource name</text><text class="detail-value">{{ activeIconInspection.smallIcon.resourceName }}</text></view>
              <view class="detail-row"><text class="detail-key">匹配 push_small</text><text class="detail-value">{{ activeIconInspection.matchPushSmall }}</text></view>
              <image v-if="activeIconInspection.smallIcon.previewDataUrl.length > 0" class="icon-preview" mode="aspectFit" :src="activeIconInspection.smallIcon.previewDataUrl" />
              <text class="setting-title">Large icon</text>
              <view class="detail-row"><text class="detail-key">类型</text><text class="detail-value">{{ activeIconInspection.largeIcon.type }}</text></view>
              <view class="detail-row"><text class="detail-key">package</text><text class="detail-value">{{ activeIconInspection.largeIcon.resourcePackage }}</text></view>
              <view class="detail-row"><text class="detail-key">resource ID</text><text class="detail-value">{{ iconResourceIdView(activeIconInspection.largeIcon.resourceId) }}</text></view>
              <view class="detail-row detail-row-last"><text class="detail-key">resource name</text><text class="detail-value">{{ activeIconInspection.largeIcon.resourceName }}</text></view>
            </view>
          </view>
        </view>
      </view>
    </scroll-view>
  </view>
</template>

<script setup lang="uts">
import { ref } from 'vue'
import { onShow } from '@dcloudio/uni-app'
import {
  getNotificationSettings,
  updateNotificationsEnabled
} from '../../services/client.uts'
import {
  bootstrapClientRuntime,
  getRuntimeFacts,
  refreshMobileRegistration,
  requestNotificationPermissionFromCta
} from '../../services/client-runtime.uts'
import {
  consentFactView,
  loginFactView,
  mobileRegistrationFactView,
  permissionView,
  presentError
} from '../../services/presentation.uts'
import type { NotificationSettings, RuntimeFacts, UiLoadState } from '../../types/models.uts'
import { getGetuiNotificationIconDiagnostics, rebindGetuiNotificationIconsForDiagnostics } from '../../services/push-runtime.uts'
import type { PushIconDiagnostics } from '../../services/push-runtime.uts'
import { inspectActiveNotificationIcons, inspectLocalNotificationIcons } from '../../services/active-notification-icon-inspector.uts'
import type { ActiveNotificationIconInspection } from '../../services/active-notification-icon-inspector.uts'
import { sendNativeNotificationIconDiagnostic } from '../../services/native-notification-icon-diagnostic.uts'
import type { NativeNotificationIconDiagnostic } from '../../services/native-notification-icon-diagnostic.uts'
import { inspectApplicationIcons } from '../../services/application-icon-inspector.uts'
import type { ApplicationIconInspection } from '../../services/application-icon-inspector.uts'

const state = ref<UiLoadState>('loading')
const settings = ref<NotificationSettings>({
  notificationsEnabled: false,
  permissionState: 'notDetermined',
  clientRegistration: 'notStarted'
})
const facts = ref<RuntimeFacts>(getRuntimeFacts())
const working = ref(false)
const banner = ref('')
const errorMessage = ref('')
const iconDiagnostics = ref<PushIconDiagnostics>(getGetuiNotificationIconDiagnostics())
const bindingIcons = ref(false)
const activeIconInspection = ref<ActiveNotificationIconInspection | null>(null)
const applicationIconInspection = ref<ApplicationIconInspection | null>(null)

const nativeDiagnostic = ref<NativeNotificationIconDiagnostic | null>(null)
const localIconInspection = ref<ActiveNotificationIconInspection | null>(null)
const sendLocalNotification = () => {
  nativeDiagnostic.value = sendNativeNotificationIconDiagnostic()
}
const readLocalNotificationIcons = () => {
  localIconInspection.value = inspectLocalNotificationIcons()
}

const resourceView = (id: number): string => id > 0 ? `found (${id})` : 'missing'
const iconResourceIdView = (id: number): string => id > 0 ? '0x' + id.toString(16) : 'unavailable'
const readCurrentNotificationIcons = () => {
  activeIconInspection.value = inspectActiveNotificationIcons()
}
const readApplicationIcons = () => {
  applicationIconInspection.value = inspectApplicationIcons()
}
const bindingView = (state: string): string => {
  if (state == 'success') return '成功'
  if (state == 'false') return '失败'
  if (state == 'exception') return '异常'
  return '未执行'
}
const sourceView = (source: string): string => source == 'auto' ? '自动' : source == 'manual' ? '手动' : '无'
const rebindIcons = () => {
  if (bindingIcons.value) return
  bindingIcons.value = true
  iconDiagnostics.value = rebindGetuiNotificationIconsForDiagnostics()
  bindingIcons.value = false
}

const runLoad = async (keepExisting: boolean) => {
  if (!keepExisting) state.value = 'loading'
  try {
    facts.value = await bootstrapClientRuntime()
    iconDiagnostics.value = getGetuiNotificationIconDiagnostics()
    if (facts.value.login != 'signedIn') {
      uni.reLaunch({ url: '/pages/login/index' })
      return
    }
    if (facts.value.privacyConsent != 'current') {
      uni.reLaunch({ url: '/pages/permission/index' })
      return
    }
    settings.value = await getNotificationSettings()
    banner.value = ''
    state.value = 'ready'
  } catch (error) {
    const shown = presentError(error, '服务暂时不可用，请稍后重试。')
    if (keepExisting) banner.value = `更新失败：${shown}`
    else {
      errorMessage.value = shown
      state.value = 'error'
    }
  }
}

const refresh = () => {
  runLoad(state.value == 'ready')
}

const goPermission = () => {
  uni.redirectTo({ url: '/pages/permission/index' })
}
const goLogin = () => {
  uni.reLaunch({ url: '/pages/login/index' })
}

const runToggleEnabled = async (event: UniSwitchChangeEvent) => {
  if (working.value) return
  const previous = settings.value.notificationsEnabled
  settings.value.notificationsEnabled = event.detail.value
  working.value = true
  try {
    settings.value = await updateNotificationsEnabled(event.detail.value)
  } catch (error) {
    settings.value.notificationsEnabled = previous
    uni.showToast({ title: presentError(error, '服务暂时不可用，请稍后重试。'), icon: 'none' })
  } finally {
    working.value = false
  }
}

const toggleEnabled = (event: UniSwitchChangeEvent) => {
  runToggleEnabled(event)
}

const runRequestNotificationPermissionFromCtaAction = async () => {
  if (working.value) return
  working.value = true
  try {
    facts.value = await requestNotificationPermissionFromCta()
    if (facts.value.recoveryCode == 'privacy_consent_required') goPermission()
    else uni.showToast({ title: '通知事实已重新核对', icon: 'none' })
  } catch (error) {
    uni.showToast({ title: presentError(error, '服务暂时不可用，请稍后重试。'), icon: 'none' })
  } finally {
    working.value = false
  }
}

const requestNotificationPermissionFromCtaAction = () => {
  runRequestNotificationPermissionFromCtaAction()
}

const runRetryRegistration = async () => {
  if (working.value) return
  working.value = true
  try {
    facts.value = await refreshMobileRegistration()
  } catch (error) {
    uni.showToast({ title: presentError(error, '通知服务注册失败，请稍后重试。'), icon: 'none' })
  } finally {
    working.value = false
  }
}

const retryRegistration = () => {
  runRetryRegistration()
}

onShow(() => {
  iconDiagnostics.value = getGetuiNotificationIconDiagnostics()
  refresh()
})
</script>

<style lang="scss">
.permission-focus { margin-top: 18px; padding: 20px; border-color: #d8e4f4; background-color: #edf3fb; }
.focus-title { margin-bottom: 8px; color: $tm-text-1; font-size: 22px; font-weight: 700; line-height: 29px; }
.focus-detail { margin-top: 8px; color: $tm-text-2; font-size: 13px; line-height: 20px; }
.setting-row { min-height: 64px; flex-direction: row; align-items: center; }
.setting-copy { min-width: 0; flex: 1; margin-right: 12px; }
.setting-title { color: $tm-text-1; font-size: 14px; font-weight: 500; line-height: 21px; }
.setting-detail { margin-top: 2px; color: $tm-text-3; font-size: 12px; line-height: 18px; }
.detail-row-last { border-bottom-width: 0; }
.notification-help { margin-top: 12px; color: $tm-text-3; font-size: 12px; line-height: 19px; }
.icon-diagnostics { margin-top: 24px; opacity: 0.85; }
.icon-preview { width: 48px; height: 48px; margin-top: 8px; margin-bottom: 12px; background-color: #edf3fb; }
</style>
