<template>
  <view class="header">
    <view v-if="back" class="header-control" hover-class="header-control-active">
      <view class="compact-label-layer"><text class="compact-label compact-label-strong">返回</text></view>
      <button class="button-hitbox" aria-label="返回上一页" @click="goBack"></button>
    </view>
    <view v-else class="header-spacer"></view>
    <text class="header-title">{{ title }}</text>
    <view v-if="actionText.length > 0" class="header-action compact-action-surface">
      <view class="compact-label-layer"><text class="compact-label">{{ actionText }}</text></view>
      <button class="button-hitbox" :aria-label="actionText" @click="emitAction"></button>
    </view>
    <view v-else class="header-spacer"></view>
  </view>
</template>

<script setup lang="uts">
type TmHeaderProps = {
  title?: string,
  back?: boolean,
  actionText?: string
}

const props = withDefaults(defineProps<TmHeaderProps>(), {
  title: '',
  back: false,
  actionText: ''
})

const emit = defineEmits(['action'])

const goBack = () => {
  uni.navigateBack({
    fail: () => {
      uni.reLaunch({ url: '/pages/dashboard/index' })
    }
  })
}

const emitAction = () => {
  emit('action')
}
</script>

<style lang="scss">
.header {
  min-height: 48px;
  flex-direction: row;
  align-items: center;
  padding-top: env(safe-area-inset-top);
}
.header-title {
  min-width: 0;
  flex: 1;
  color: $tm-text-1;
  font-size: 18px;
  font-weight: 600;
  line-height: 22px;
  text-align: center;
}
.header-control, .header-spacer { width: 48px; min-width: 48px; height: 48px; }
.header-control {
  position: relative;
  box-sizing: border-box;
  border-width: 1px;
  border-style: solid;
  border-color: $tm-line;
  border-radius: $tm-radius-md;
  background-color: $tm-surface-1;
}
.header-control-active { opacity: 0.68; }
.header-action { min-width: 48px; }
</style>
