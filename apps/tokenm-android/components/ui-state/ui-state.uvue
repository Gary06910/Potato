<template>
  <view v-if="mode == 'loading'" :class="['skeleton', compact ? 'skeleton-compact' : '', 'skeleton-' + variant]" aria-label="正在加载">
    <view class="skeleton-line skeleton-title"></view>
    <view class="skeleton-line"></view>
    <view class="skeleton-line skeleton-short"></view>
    <view v-if="variant == 'list'" class="skeleton-line skeleton-row"></view>
    <view v-if="variant == 'dashboard'" class="skeleton-card"></view>
  </view>
  <view v-else :class="['state', compact ? 'state-compact' : '']">
    <view :class="['state-mark', mode == 'error' ? 'state-mark-error' : 'state-mark-empty']">
      <view v-if="mode == 'error'" class="error-line"></view>
      <view v-if="mode == 'error'" class="error-dot"></view>
      <view v-if="mode != 'error'" class="empty-line empty-line-one"></view>
      <view v-else class="empty-line empty-line-two"></view>
    </view>
    <text class="state-title">{{ title }}</text>
    <text v-if="detail.length > 0" class="state-detail">{{ detail }}</text>
    <view v-if="actionText.length > 0" class="state-action compact-action-surface">
      <view class="compact-label-layer"><text class="compact-label">{{ actionText }}</text></view>
      <button class="button-hitbox" :aria-label="actionText" @click="emitAction"></button>
    </view>
  </view>
</template>

<script setup lang="uts">
type UiStateProps = {
  mode?: string,
  title?: string,
  detail?: string,
  actionText?: string,
  compact?: boolean,
  variant?: string
}

withDefaults(defineProps<UiStateProps>(), {
  mode: 'loading',
  title: '',
  detail: '',
  actionText: '',
  compact: false,
  variant: 'default'
})

const emit = defineEmits(['action'])
const emitAction = () => {
  emit('action')
}
</script>

<style lang="scss">
.skeleton { padding-top: 20px; padding-bottom: 20px; }
.skeleton-compact { padding-top: 12px; padding-bottom: 12px; }
.skeleton-line { width: 100%; height: 14px; margin-top: 10px; border-radius: $tm-radius-sm; background-color: $tm-skeleton; }
.skeleton-title { width: 58%; height: 20px; margin-top: 0; }
.skeleton-short { width: 72%; }
.skeleton-row { height: 44px; margin-top: 16px; }
.skeleton-card { height: 104px; margin-top: 18px; border-radius: $tm-radius-lg; background-color: $tm-skeleton; }
.state { min-height: 180px; align-items: center; justify-content: center; padding-top: 24px; padding-right: 16px; padding-bottom: 24px; padding-left: 16px; }
.state-compact { min-height: 108px; padding-top: 12px; padding-bottom: 12px; }
.state-mark { width: 24px; height: 24px; margin-bottom: 10px; align-items: center; justify-content: center; }
.state-mark-error { border-width: 1px; border-style: solid; border-color: $tm-warning; border-radius: 12px; }
.error-line { width: 2px; height: 8px; background-color: $tm-warning; }
.error-dot { width: 2px; height: 2px; margin-top: 3px; border-radius: 1px; background-color: $tm-warning; }
.state-mark-empty { border-width: 1px; border-style: solid; border-color: $tm-text-3; border-radius: $tm-radius-sm; }
.empty-line { height: 1px; background-color: $tm-text-3; }
.empty-line-one { width: 12px; }
.empty-line-two { width: 8px; margin-top: 4px; }
.state-title { color: $tm-text-1; font-size: 15px; font-weight: 600; line-height: 22px; text-align: center; }
.state-detail { max-width: 290px; margin-top: 4px; color: $tm-text-2; font-size: 13px; line-height: 20px; text-align: center; }
.state-action { min-width: 48px; margin-top: 8px; }
</style>
