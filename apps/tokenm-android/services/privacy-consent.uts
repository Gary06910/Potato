import type { PrivacyConsentRecord } from '../types/models.uts'
import { getPageCacheSession, isPageCacheSessionCurrent } from './page-cache.uts'

const tokenmCo = uniCloud.importObject('tokenm-co', { customUI: true })

const mapConsent = (value: UTSJSONObject): PrivacyConsentRecord => ({
  requiredVersion: value.getString('requiredVersion') ?? '',
  acceptedVersion: value.getString('acceptedVersion'),
  acceptedAt: value.getString('acceptedAt'),
  isCurrent: value.getBoolean('isCurrent') ?? false
})

let consentInFlight: Promise<PrivacyConsentRecord> | null = null
let consentSession = -1
let currentConsent: PrivacyConsentRecord | null = null
let checkedAt = 0
// A business RPC always enforces the current server version, even inside this TTL.
const CONSENT_FRESH_MS = 30000

const readConsent = async (session: number): Promise<PrivacyConsentRecord> => {
  const result = await tokenmCo.getPrivacyConsent({})
  if (!isPageCacheSessionCurrent(session)) throw new Error('page_session_changed')
  const consent = mapConsent(result.privacyConsent as UTSJSONObject)
  currentConsent = consent.isCurrent ? consent : null
  checkedAt = Date.now()
  return consent
}

export const getCurrentPrivacyConsent = (): Promise<PrivacyConsentRecord> => {
  const session = getPageCacheSession()
  if (consentSession == session && currentConsent != null && Date.now() - checkedAt < CONSENT_FRESH_MS) return Promise.resolve(currentConsent!)
  if (consentSession != session) currentConsent = null
  if (consentInFlight != null && consentSession == session) return consentInFlight!
  const task = readConsent(session)
  consentInFlight = task
  consentSession = session
  task.then(
    () => { if (consentInFlight == task) consentInFlight = null },
    () => { if (consentInFlight == task) consentInFlight = null }
  )
  return task
}

export const acceptRequiredPrivacyConsent = async (): Promise<PrivacyConsentRecord> => {
  const current = await getCurrentPrivacyConsent()
  if (current.requiredVersion.length == 0) throw new Error('privacy consent version unavailable')
  const result = await tokenmCo.updatePrivacyConsent({ version: current.requiredVersion })
  return mapConsent(result.privacyConsent as UTSJSONObject)
}
